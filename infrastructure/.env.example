# Copy to infrastructure/.env (or run scripts/generate-secrets.ps1, it does this with random values).
# The real .env is in .gitignore. Never commit it.
POSTGRES_PASSWORD=change-me
# P2-11: private keys of JWT signing (RS256). Files are OUTSIDE the repository; the dev profile creates them on first start.
JWT_PRIVATE_KEY_FILE=C:\Users\you\.wms\keys\jwt-private.pem
REQUEST_SERVICE_KEY_FILE=C:\Users\you\.wms\keys\request-service-private.pem
BOOTSTRAP_ADMIN_PASSWORD=change-me
WMS_ADMIN_PASSWORD=change-me

# P1-9: отдельные роли БД. <SVC>_MIGRATION_* = владелец базы (Flyway), <SVC>_DB_* = runtime-роль сервиса.
# Пароли добавляет scripts/generate-db-passwords.ps1 (случайные значения, существующие не трогает).
AUTH_MIGRATION_USER=auth_owner
AUTH_MIGRATION_PASSWORD=change-me
AUTH_DB_USER=auth_app
AUTH_DB_PASSWORD=change-me
CATALOG_MIGRATION_USER=catalog_owner
CATALOG_MIGRATION_PASSWORD=change-me
CATALOG_DB_USER=catalog_app
CATALOG_DB_PASSWORD=change-me
WAREHOUSE_MIGRATION_USER=warehouse_owner
WAREHOUSE_MIGRATION_PASSWORD=change-me
WAREHOUSE_DB_USER=warehouse_app
WAREHOUSE_DB_PASSWORD=change-me
INVENTORY_MIGRATION_USER=inventory_owner
INVENTORY_MIGRATION_PASSWORD=change-me
INVENTORY_DB_USER=inventory_app
INVENTORY_DB_PASSWORD=change-me
REQUEST_MIGRATION_USER=request_owner
REQUEST_MIGRATION_PASSWORD=change-me
REQUEST_DB_USER=request_app
REQUEST_DB_PASSWORD=change-me
NOTIFICATION_MIGRATION_USER=notification_owner
NOTIFICATION_MIGRATION_PASSWORD=change-me
NOTIFICATION_DB_USER=notification_app
NOTIFICATION_DB_PASSWORD=change-me
AUDIT_MIGRATION_USER=audit_owner
AUDIT_MIGRATION_PASSWORD=change-me
AUDIT_DB_USER=audit_app
AUDIT_DB_PASSWORD=change-me
REPORT_MIGRATION_USER=report_owner
REPORT_MIGRATION_PASSWORD=change-me
REPORT_DB_USER=report_app
REPORT_DB_PASSWORD=change-me
