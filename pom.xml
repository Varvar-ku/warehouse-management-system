<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
		 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		 xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.1</version>
		<relativePath/>
	</parent>

	<groupId>ru.warehouse</groupId>
	<artifactId>warehouse-management-system</artifactId>
	<version>1.0.0-SNAPSHOT</version>
	<packaging>pom</packaging> <!-- корень только агрегирует модули -->

	<properties>
		<java.version>21</java.version>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<spring-cloud.version>2025.1.3</spring-cloud.version>
	</properties>

	<!-- Модуль добавляется сюда только после того, как создана его папка с pom.xml -->
	<modules>
		<module>common-lib</module>
		<module>catalog-service</module>
		<module>auth-service</module>
		<module>api-gateway</module>
		<module>warehouse-service</module>
		<module>inventory-service</module>
	</modules>

	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>org.springframework.cloud</groupId>
				<artifactId>spring-cloud-dependencies</artifactId>
				<version>${spring-cloud.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
			<!-- Версия common-lib задаётся здесь, в модулях указывается без <version> -->
			<dependency>
				<groupId>ru.warehouse</groupId>
				<artifactId>common-lib</artifactId>
				<version>${project.version}</version>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<!-- JDK 23+ не запускает процессоры аннотаций с classpath автоматически.
         Явно подключаем Lombok для всех модулей (версия берётся из Spring Boot BOM) -->
	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<configuration>
					<annotationProcessorPaths>
						<path>
							<groupId>org.projectlombok</groupId>
							<artifactId>lombok</artifactId>
							<version>${lombok.version}</version>
						</path>
					</annotationProcessorPaths>
				</configuration>
			</plugin>
		</plugins>
	</build>
</project>